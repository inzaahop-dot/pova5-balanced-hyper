{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Balanced Hyper",
  "version": "0.1.0",
  "description": "Original design tokens for the Balanced Hyper theme (HyperOS-inspired, not copied). DESIGN_PROPOSAL; unverified on device.",
  "themes": {
    "light": {
      "color": {
        "bg": {
          "canvas": "#F5F6F8",
          "surface": "#FFFFFF",
          "surface-elevated": "#FFFFFF",
          "surface-subtle": "#F0F1F3"
        },
        "text": {
          "primary": "#1A1C1F",
          "secondary": "#5B5F66",
          "tertiary": "#8A8F98",
          "disabled": "#B6BBC3"
        },
        "divider": "#E3E5E9",
        "accent": {
          "primary": "#2E6BB5",
          "primary-container": "#DCE6F5"
        },
        "state": {
          "success": "#2E8B57",
          "warning": "#B87A1A",
          "error": "#C0392B",
          "info": "#2E6BB5"
        }
      }
    },
    "dark": {
      "color": {
        "bg": {
          "canvas": "#0E1013",
          "surface": "#16181C",
          "surface-elevated": "#1E2025",
          "surface-subtle": "#14161A"
        },
        "text": {
          "primary": "#E6E8EC",
          "secondary": "#A9AEB6",
          "tertiary": "#7A7F87",
          "disabled": "#555A62"
        },
        "divider": "#2A2D33",
        "accent": {
          "primary": "#6FA0E6",
          "primary-container": "#1F2F4A"
        },
        "state": {
          "success": "#5FBF8A",
          "warning": "#D9A04A",
          "error": "#E06B5F",
          "info": "#6FA0E6"
        }
      }
    }
  },
  "typography": {
    "fontFamily": "system",
    "scale": {
      "xs": { "size": 11, "lineHeight": 16 },
      "sm": { "size": 12, "lineHeight": 18 },
      "md": { "size": 14, "lineHeight": 20 },
      "lg": { "size": 16, "lineHeight": 24 },
      "xl": { "size": 20, "lineHeight": 28 },
      "2xl": { "size": 24, "lineHeight": 32 },
      "3xl": { "size": 30, "lineHeight": 38 }
    },
    "weights": [400, 500, 600]
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999
  },
  "elevation": {
    "0": 0,
    "1": 2,
    "2": 4,
    "3": 8
  },
  "motion": {
    "duration": { "fast": 120, "normal": 200, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)"
    }
  }
}